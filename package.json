{
  "name": "basher",
  "version": "1.18.1",
  "description": "Basher - MCP server for executing commands with enhanced logging, history tracking, and improved visibility",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "basher": "dist/index.js",
    "basher-light": "dist/index-light.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:light": "node dist/index-light.js",
    "dev": "tsx src/index.ts",
    "dev:light": "tsx src/index-light.ts",
    "watch": "tsc --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "command-execution",
    "logging",
    "history",
    "claude"
  ],
  "author": "Bazilikum",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bazilikum/basher.git"
  },
  "bugs": {
    "url": "https://github.com/Bazilikum/basher/issues"
  },
  "homepage": "https://github.com/Bazilikum/basher#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@toon-format/toon": "^1.0.0",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
