{
  "name": "basher",
  "version": "1.0.0",
  "description": "Basher - MCP server for executing commands with enhanced logging, history tracking, and improved visibility",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "basher": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "command-execution",
    "logging",
    "history",
    "claude"
  ],
