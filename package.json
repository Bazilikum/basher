  "repository": {
    "type": "git",
    "url": "https://github.com/Bazilikum/basher.git"
  },
  "bugs": {
    "url": "https://github.com/Bazilikum/basher/issues"
  },
  "homepage": "https://github.com/Bazilikum/basher#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@toon-format/toon": "^1.0.0",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
